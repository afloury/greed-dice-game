{
  "name": "greed-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite",
    "dev-host": "NODE_ENV=development vite --host",
    "test-prod": "NODE_ENV=production vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:dev-local": "tsx worker/dev-server.ts",
    "worker:deploy": "wrangler deploy",
    "dev:all": "concurrently -n vite,worker -c blue,green \"pnpm run dev-host\" \"pnpm run worker:dev-local\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.3",
    "@tailwindcss/vite": "^4.1.3",
    "pinia": "^3.0.2",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260403.1",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^13.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4",
    "wrangler": "^4.80.0",
    "ws": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
